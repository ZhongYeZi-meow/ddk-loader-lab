# Independent compile-only Android kernel fixture, not a device boot config.
# Reduced tracing/BPF features produce real configuration-derived module ABI
# differences. Keep forward/backward edge compiler instrumentation enabled.
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_CLANG_SHADOW=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_KALLSYMS=y
CONFIG_LOCALVERSION="-kh-source-lab"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_CFI_PERMISSIVE is not set
